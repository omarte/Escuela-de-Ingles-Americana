# ═══════════════════════════════════════════════════════════════════════════════
# Escuela de Inglés Americana — Mobile App Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env inside apps/app/ for local mobile development with Expo.
# NEVER commit .env files containing real production secrets or keys to Git.
# ═══════════════════════════════════════════════════════════════════════════════

# Public URL of your Supabase Project
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous (anon) Key for client-side queries (protected by RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Environment identifier: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development

# Offline/Demo Mode toggle:
# Set to 'false' in production to sync with remote Supabase.
# Set to 'true' to force local-only operation with SQLite & mock auth.
EXPO_PUBLIC_DEMO_MODE=false
