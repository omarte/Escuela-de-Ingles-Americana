{
  "expo": {
    "name": "Escuela de Inglés Americana",
    "slug": "escuela-de-ingles-americana",
    "owner": "omarte2027s-team",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "elp",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-screen.jpg",
      "backgroundColor": "#059669",
      "resizeMode": "cover"
    },
    "updates": {
      "url": "https://u.expo.dev/094201bb-0ebb-4fa7-b7ca-e73da8a83d1d",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elp.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "package": "com.elp.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "094201bb-0ebb-4fa7-b7ca-e73da8a83d1d"
      }
    }
  }
}
