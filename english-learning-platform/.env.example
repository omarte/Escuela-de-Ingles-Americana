# ═══════════════════════════════════════════════════════════════════════════════
# Escuela de Inglés Americana — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env (or apps/app/.env) and replace placeholders with real values.
# NEVER commit .env files containing real production secrets or keys to Git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Remote Backend Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Public URL of your Supabase Project.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous (anon) Key for client-side queries.
# Safe to include in mobile builds; protected by Row Level Security (RLS).
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Server-Side / Administration Secrets (CRITICAL)
# ─────────────────────────────────────────────────────────────────────────────
# Service Role Key: Bypasses Row Level Security (RLS).
# MUST NEVER be shared with mobile clients or committed to version control.
# Used exclusively by migrations, administrative scripts, and backend workers.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Direct PostgreSQL Connection String
# Used for direct database administration (psql, migrations, pg_dump).
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Application Runtime Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Environment identifier: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development

# Offline/Demo Mode toggle:
# Set to 'false' in production so the app actively syncs with Supabase.
# Set to 'true' to force local-only operation with SQLite & mock auth.
EXPO_PUBLIC_DEMO_MODE=false
